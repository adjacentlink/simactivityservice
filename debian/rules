#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_CXXFLAGS_MAINT_APPEND = -O3 -Wall -Wextra

# install python modules into /usr/lib/python3/dist-packages
export DEB_PYTHON_INSTALL_LAYOUT = deb_system

%:
	dh $@ --with python3 --without autoreconf

# scripts use '#!/usr/bin/env python', force python3
override_dh_python3:
	dh_python3 --shebang=/usr/bin/python3

# no test suite
override_dh_auto_test:

# libostatistic may come from a package without shlibs information
override_dh_shlibdeps:
	dh_shlibdeps -- --ignore-missing-info
